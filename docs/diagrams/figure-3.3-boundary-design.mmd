flowchart TB
    subgraph Inbound[Inbound Adapter Layer]
        Controller[ProductController\nHTTP + security + status codes]
        WebMapper[ProductWebMapper\nDTO ↔ Command/Result]
    end

    subgraph Application[Application Layer]
        AppService[ProductApplicationService\nUse-case orchestration]
        PrimaryPorts[Primary Ports\nCreate / Update / Delete / Get / List]
        ACLPort[ProductLookupService\nRead-only ACL port]
    end

    subgraph Domain[Domain Layer]
        Entities[Product model + invariants]
        SecondaryPorts[Secondary Ports\nProductRepository contract]
    end

    subgraph Outbound[Outbound Adapters]
        LookupAdapter[ProductLookupAdapter\nLegacy reads -> new product module]
        LegacyCrud[ProductsCrudServiceImpl\nLegacy writes remain here]
        RepoAdapter[Persistence adapter\nJPA / Spring Data]
    end

    Controller --> WebMapper
    WebMapper --> AppService
    AppService --> PrimaryPorts
    AppService --> ACLPort
    ACLPort --> LookupAdapter
    PrimaryPorts --> LegacyCrud
    SecondaryPorts --> RepoAdapter
    LookupAdapter --> AppService
    LegacyCrud --> SecondaryPorts
    RepoAdapter --> Entities

