graph TB
  subgraph Infrastructure[Infrastructure (outermost)]
    Infra[Spring Boot / JPA / SQL / Config]
  end
  subgraph Adapter[Adapter Layer]
    AdapterInbound[Inbound: Controllers / DTOs]
    AdapterOutbound[Outbound: Repository Adapters]
  end
  subgraph Application[Application Layer]
    App[Use-cases / Application Services]
  end
  subgraph Domain[Domain Core (innermost)]
    DomainCore[Aggregates / Value Objects / Ports]
  end

  Infra --> AdapterInbound
  Infra --> AdapterOutbound
  AdapterInbound --> App
  AdapterOutbound --> App
  App --> DomainCore
