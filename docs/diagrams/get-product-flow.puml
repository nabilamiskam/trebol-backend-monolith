@startuml
title GET /product-module/{id} flow
actor Client
participant "ProductController\n(inbound adapter)" as Controller
participant "ProductApplicationService\n(application layer)" as AppService
participant "ProductRepository\n(port, implemented by ProductRepositoryAdapter)" as RepoPort
participant "ProductRepositoryAdapter\n(outbound adapter)" as RepoAdapter
participant "ProductPersistenceMapper" as PersistMapper
participant "ProductJpaRepository\n(Spring Data JPA)" as JpaRepo
database "Database" as DB
participant "ProductApplicationMapper" as AppMapper
participant "ProductWebMapper" as WebMapper

Client -> Controller: GET /product-module/1
Controller -> AppService: execute(GetProductQuery(1))
AppService -> RepoPort: findById(ProductId(1))
RepoPort -> RepoAdapter: dispatch to injected implementation
RepoAdapter -> JpaRepo: findById(1)
JpaRepo -> DB: SQL select
DB --> JpaRepo: ProductJpaEntity row
JpaRepo --> RepoAdapter: ProductJpaEntity
RepoAdapter -> PersistMapper: toAggregate(entity)
PersistMapper --> RepoAdapter: ProductAggregate
RepoAdapter --> AppService: ProductAggregate
AppService -> AppMapper: toResult(aggregate)
AppMapper --> AppService: ProductResult
AppService --> Controller: ProductResult
Controller -> WebMapper: toResponse(result)
WebMapper --> Controller: ProductResponse
Controller --> Client: 200 OK + JSON

@enduml
